{
  "output_dir": "${COMPLEXITY_OUTPUT}",
  "inputs": {
    "human_scanpaths_file": "${COMPLEXITY_DATA}/coco_search18_fixations_TP_merged.json",
    "coco_scanpaths_file": "${COMPLEXITY_DATA}/coco_search18_all_scanpaths.json",
    "nsd_scanpaths_file": "${COMPLEXITY_DATA}/nsd_all_scanpaths.json",
    "nsd_metadata_file": "${BRAIN_DATA}/nsd_augmentation_data/metadata.json",
    "coco_images_dir": "${BRAIN_DATA}/coco_search_18/images",
    "coco_bboxes_file": "${BRAIN_DATA}/coco_search_18/coco_search18_bboxes.json",
    "nsd_images_dir": "${BRAIN_DATA}/nsd_complexity/images",
    "nsd_bboxes_file": "${BRAIN_DATA}/nsd_complexity/nsd_bboxes.json"
  },
  "sampling": {
    "draws": 2000,
    "tune": 2000,
    "chains": 4,
    "seed": 42,
    "target_accept": 0.95,
    "cv_draws": 600,
    "cv_tune": 600,
    "cv_chains": 2,
    "cv_folds": 5
  },
  "generation": {
    "devices": [
      "cuda:0",
      "cuda:1",
      "cuda:2",
      "cuda:3"
    ],
    "seed": 1000,
    "precision": "amp",
    "profiles": {
      "coco": {
        "devices": [
          "cuda:0"
        ],
        "precision": "float32"
      }
    },
    "scandiff_root": "${SCANDIFF_ROOT}",
    "python_file": "${SCANDIFF_PYTHON}"
  }
}
