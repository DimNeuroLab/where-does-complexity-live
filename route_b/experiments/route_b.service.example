[Unit]
Description=Route B experiment
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/where-does-complexity-live
ExecStart=/absolute/path/to/.venv-routeb/bin/python -u -m route_b.run --config /absolute/path/to/route_b.json --resume
Environment=NSD_DATA=/absolute/path/to/algonauts_2023_challenge_data
Environment=ROUTE_B_OUTPUT=/absolute/path/to/route_b_run
Environment=DINOV2_ROOT=/absolute/path/to/dinov2
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=60
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=default.target
